# ============================================
# Spottery Monorepo 环境变量示例
# 复制为 .env 并填入实际值（.env 已被 gitignore）
# ============================================

# PostgreSQL 超级用户（初始化建库用）
POSTGRES_PASSWORD=change-me-postgres

# 应用账号密码（crawler_* / api_service）
PG_APP_PASSWORD=change-me-app

# JWT（后端阶段使用，预留）
JWT_SECRET_KEY=change-me-jwt
JWT_EXPIRE_DAYS=7

# 内部通信令牌（爬虫↔后端，预留）
INTERNAL_API_KEY=change-me-internal
